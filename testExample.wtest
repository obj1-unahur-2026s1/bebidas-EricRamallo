import bebidas.*
import personas.*

describe "Tito el deportista" {

  test "La velocidad de Tito si consume whisky" {
    tito.consumir(100, whisky)
    assert.equals(0.00021, tito.velocidad())
  }
  test "La velocidad de Tito si consume terere" {
    tito.consumir(100, terere)
    assert.equals(70, tito.velocidad())
  }
  test "La velocidad de Tito si consume cianuro" {
    tito.consumir(100, cianuro)
    assert.equals(0, tito.velocidad())
  }
}